{
    "name": "collector-bank/collector-checkout-magento2",
    "license": "Apache-2.0",
    "type": "magento2-module",
    "description": "Magento 2 Collector Bank Checkout Module",
    "require": {
        "php": ">=7.4"
    },
    "authors": [
        {
            "name": "Webbhuset",
            "email": "info@webbhuset.com"
        }
    ],
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Webbhuset\\CollectorCheckout\\": "src/"
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
